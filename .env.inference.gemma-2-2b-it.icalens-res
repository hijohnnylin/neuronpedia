# ICA Lens (arXiv 2606.11722) fitted on gemma-2-2b-it with UltraChat. MODEL_ID is the
# base id because that is the SAELens key the -it pods resolve to.
MODEL_ID=google/gemma-2-2b
OVERRIDE_MODEL_ID=google/gemma-2-2b-it
MODEL_DTYPE=bfloat16
SAE_DTYPE=float32
SAE_SETS='["icalens-res"]'
MAX_LOADED_SAES=200
TOKEN_LIMIT=1024
