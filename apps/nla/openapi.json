            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compare"
      }
    },
    "/completion": {
      "post": {
        "description": "Generate a continuation for the prompt and return tokens for the\nfull (prompt + completion) text. Set `stream=true` to receive tokens\nincrementally as SSE events.",
        "operationId": "completion_completion_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Secret-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
