          "text": {
            "anyOf": [
              {
                "maxLength": 65536,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input text to tokenize (or provide `messages`).",
            "title": "Text"
          }
        },
        "title": "TokenizeRequest",
        "type": "object"
      },
      "TokenizeResponse": {
        "properties": {
          "prompt_length": {
            "description": "Number of tokens from the original input text",
            "title": "Prompt Length",
            "type": "integer"
          },
          "text": {
            "description": "Full text (original + any generated completion)",
            "title": "Text",
            "type": "string"
          },
          "tokens": {
            "items": {
              "$ref": "#/components/schemas/TokenInfo"
            },
            "title": "Tokens",
            "type": "array"
          }
        },
        "required": [
          "tokens",
          "prompt_length",
          "text"
        ],
        "title": "TokenizeResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Natural Language Autoencoder \u2014 activation vector <-> text",
    "title": "NLA Inference Server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Health check.",
        "operationId": "root__get",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
