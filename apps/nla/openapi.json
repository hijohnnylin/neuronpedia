          "reverse": {
            "default": true,
            "description": "Process token positions in reverse order (last to first)",
            "title": "Reverse",
            "type": "boolean"
          },
          "stream": {
            "default": false,
            "description": "Stream results as SSE events",
            "title": "Stream",
            "type": "boolean"
          },
          "temperature": {
            "default": 0.7,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 65536,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Input text to extract activations from (or provide `messages`).",
            "title": "Text"
          }
        },
        "title": "ExplainRequest",
        "type": "object"
      },
      "ExplainResponse": {
        "properties": {
          "layer_index": {
