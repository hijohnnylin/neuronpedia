              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Completion"
      }
    },
    "/describe": {
      "post": {
        "description": "Describe activation vector(s) in natural language, with optional MSE scores.\n\nSet stream=true to receive partial text updates as SSE events.\nStreaming events:\n  - Partial: {\"index\": i, \"text\": \"partial...\", \"done\": false}\n  - Final:   {\"index\": i, \"description\": \"...\", \"mse\": ..., \"cosine_similarity\": ...}\n  - End:     [DONE]",
        "operationId": "describe_describe_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Secret-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DescribeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DescribeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Describe"
      }
    },
    "/explain": {
      "post": {
        "description": "Extract activations and describe them in natural language.\n\nIf positions is omitted, all token positions are described.\nPositions use Python-style indexing (negative values count from end).\nSet stream=true to receive results as SSE events.\n\nUp to NLA_MAX_CONCURRENT_EXPLAINS requests run in parallel; the\n(N+1)th request gets HTTP 429 (fail-fast, no queueing). Verbalizer\nfan-out across all parallel /explains is bounded by NLA_MAX_CONCURRENT\nvia a server-wide semaphore, so KV-pool occupancy stays capped.",
        "operationId": "explain_explain_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Secret-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplainRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplainResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Explain"
      }
    },
    "/extract": {
      "post": {
        "description": "Extract per-token activation vectors from the source model.",
        "operationId": "extract_extract_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Secret-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Extract"
      }
    },
    "/score": {
      "post": {
        "description": "Score an existing text description against the original activation vector.\n\nThe reconstructor forward pass is blocking torch work, so we run it on\na thread-pool executor (via run_in_executor) to keep the FastAPI event\nloop responsive \u2014 otherwise concurrent /describe streams, /health,\netc. would all stall while a /score is in flight. Concurrency is\ncapped by NLA_RECONSTRUCTOR_MAX_CONCURRENT to bound VRAM and keep the\nexecutor pool from drowning.",
        "operationId": "score_score_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Secret-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Score"
      }
    },
    "/tokenize": {
      "post": {
        "description": "Tokenize text (or structured chat `messages`) using the source model's\ntokenizer. When `messages` is provided, the model's chat template is applied\nserver-side and per-token span metadata is returned.",
        "operationId": "tokenize_tokenize_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Secret-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tokenize"
      }
    }
  }
