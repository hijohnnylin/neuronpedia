            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Root"
      }
    },
    "/compare": {
      "post": {
        "description": "Describe the difference between two activation vectors (a - b).",
        "operationId": "compare_compare_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Secret-Key"
