{
  "components": {
    "schemas": {
      "ChatMessageInput": {
        "properties": {
          "channel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional harmony channel (analysis/final/commentary) for assistant turns.",
            "title": "Channel"
          },
          "content": {
            "default": "",
            "description": "Message text",
            "title": "Content",
            "type": "string"
          },
          "role": {
            "description": "Chat role, e.g. user / assistant / system",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "title": "ChatMessageInput",
        "type": "object"
      },
      "CompareRequest": {
        "properties": {
          "activation_a": {
            "description": "First activation vector",
            "items": {
              "type": "number"
            },
            "title": "Activation A",
            "type": "array"
          },
          "activation_b": {
            "description": "Second activation vector",
            "items": {
              "type": "number"
            },
            "title": "Activation B",
            "type": "array"
          },
          "max_new_tokens": {
            "default": 200,
            "exclusiveMinimum": 0.0,
            "maximum": 4096.0,
            "title": "Max New Tokens",
            "type": "integer"
          },
          "temperature": {
            "default": 0.7,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          }
        },
        "required": [
          "activation_a",
          "activation_b"
        ],
        "title": "CompareRequest",
        "type": "object"
      },
      "CompareResponse": {
        "properties": {
          "cosine_similarity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cosine Similarity"
          },
          "description": {
            "description": "Description of the difference vector (a - b)",
            "title": "Description",
            "type": "string"
          },
          "diff_norm": {
            "description": "L2 norm of the difference vector",
            "title": "Diff Norm",
            "type": "number"
          },
          "mse": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mse"
          }
        },
        "required": [
          "description",
          "diff_norm"
        ],
        "title": "CompareResponse",
        "type": "object"
      },
      "CompletionRequest": {
        "properties": {
          "add_generation_prompt": {
            "default": true,
            "title": "Add Generation Prompt",
            "type": "boolean"
          },
          "completion_tokens": {
            "default": 16,
            "description": "Number of tokens to generate as continuation (clamped server-side to 1-512).",
            "minimum": 1.0,
            "title": "Completion Tokens",
            "type": "integer"
          },
          "continue_final_message": {
            "default": false,
            "title": "Continue Final Message",
            "type": "boolean"
          },
          "enable_thinking": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enable Thinking"
          },
          "messages": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ChatMessageInput"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Structured chat messages. When set, the server applies the model's chat template (ignoring `text`) and returns per-token spans.",
            "title": "Messages"
          },
          "stream": {
            "default": false,
            "description": "If true, stream tokens as SSE events instead of returning the full response.",
            "title": "Stream",
            "type": "boolean"
          },
          "temperature": {
            "default": 0.7,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 65536,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Prompt text to extend (or provide `messages`).",
            "title": "Text"
          }
        },
        "title": "CompletionRequest",
        "type": "object"
      },
      "DescribeRequest": {
        "properties": {
          "activations": {
            "description": "List of activation vectors, each of length d_model",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "maxItems": 512,
            "minItems": 1,
            "title": "Activations",
            "type": "array"
          },
          "max_new_tokens": {
            "default": 200,
            "exclusiveMinimum": 0.0,
            "maximum": 4096.0,
            "title": "Max New Tokens",
            "type": "integer"
          },
          "stream": {
            "default": false,
            "description": "Stream results as SSE events",
            "title": "Stream",
            "type": "boolean"
          },
          "temperature": {
            "default": 0.7,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          }
        },
        "required": [
          "activations"
        ],
        "title": "DescribeRequest",
        "type": "object"
      },
      "DescribeResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/DescriptionResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "DescribeResponse",
        "type": "object"
      },
      "DescriptionResult": {
        "properties": {
          "cosine_similarity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cosine similarity (if reconstructor available)",
            "title": "Cosine Similarity"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "mse": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reconstruction MSE (if reconstructor available)",
            "title": "Mse"
          }
        },
        "required": [
          "description"
        ],
        "title": "DescriptionResult",
        "type": "object"
      },
      "ExplainRequest": {
        "properties": {
          "add_generation_prompt": {
            "default": true,
