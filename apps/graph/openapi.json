      "SteerResponse": {
        "description": "Default and steered generations, plus per-token logits for each.\n\nThe SCREAMING_SNAKE keys are the wire names, so they are spelled out as aliases rather than\nleft to the field names: ``/api/steer-logits`` returns this object nearly verbatim and its\nswagger documents them in this form.",
        "properties": {
          "DEFAULT_GENERATION": {
            "title": "Default Generation",
            "type": "string"
          },
          "DEFAULT_LOGITS_BY_TOKEN": {
            "items": {
              "$ref": "#/components/schemas/LogitsByToken"
            },
            "title": "Default Logits By Token",
            "type": "array"
          },
          "STEERED_GENERATION": {
            "title": "Steered Generation",
            "type": "string"
