                "type": "null"
              }
            ],
            "title": "Messages"
          },
          "prompt": {
            "default": "",
            "title": "Prompt",
            "type": "string"
          }
        },
        "title": "ForwardPassRequest",
        "type": "object"
      },
      "ForwardPassResponse": {
        "description": "The salient-logit payload.\n\nA failed pass returns ``{\"error\": ...}`` with a 200 instead of this, which the spec does\nnot describe -- callers check for ``error`` before reading any of these fields. Keeping\nthat shape out of the model is what lets the five fields below stay required.",
        "properties": {
          "cumulative_probability": {
            "title": "Cumulative Probability",
            "type": "number"
          },
          "input_tokens": {
            "items": {
              "type": "string"
            },
            "title": "Input Tokens",
            "type": "array"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "salient_logits": {
            "items": {
              "$ref": "#/components/schemas/SalientLogit"
            },
            "title": "Salient Logits",
            "type": "array"
          },
          "total_salient_tokens": {
            "title": "Total Salient Tokens",
            "type": "integer"
          }
        },
        "required": [
          "prompt",
          "input_tokens",
          "salient_logits",
          "total_salient_tokens",
          "cumulative_probability"
        ],
        "title": "ForwardPassResponse",
        "type": "object"
      },
      "GraphChatMessage": {
        "description": "One structured chat turn.\n\nRoles come back canonical rather than as the template's literal label, so a gemma\n``model`` turn is reported as ``assistant``.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "GraphChatMessage",
        "type": "object"
      },
