                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Messages"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "node_threshold": {
            "default": 0.8,
            "title": "Node Threshold",
            "type": "number"
          },
          "prompt": {
            "default": "",
            "title": "Prompt",
            "type": "string"
          },
          "qk_top_fraction": {
            "default": 0.6,
            "title": "Qk Top Fraction",
            "type": "number"
          },
          "qk_topk": {
            "default": 10,
            "title": "Qk Topk",
            "type": "integer"
          },
          "signed_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signed Url"
          },
          "slug_identifier": {
            "title": "Slug Identifier",
            "type": "string"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "required": [
          "model_id",
          "slug_identifier"
