          "desired_logit_prob": {
            "default": 0.95,
            "title": "Desired Logit Prob",
            "type": "number"
          },
          "edge_threshold": {
            "default": 0.98,
            "title": "Edge Threshold",
            "type": "number"
          },
          "enable_qk_tracing": {
            "default": false,
            "title": "Enable Qk Tracing",
            "type": "boolean"
          },
          "max_feature_nodes": {
            "default": 10000,
