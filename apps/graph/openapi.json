  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/check-busy": {
      "get": {
        "description": "Check if the server is currently busy processing a request.",
        "operationId": "check_busy_check_busy_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckBusyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check Busy"
      }
    },
    "/forward-pass": {
      "post": {
        "description": "Handle forward pass requests to get salient logits",
        "operationId": "forward_pass_handler_forward_pass_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "title": "X-Secret-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForwardPassRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForwardPassResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Forward Pass Handler"
      }
    },
    "/generate-graph": {
      "post": {
        "operationId": "generate_graph_generate_graph_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "title": "X-Secret-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphGenerationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphGenerationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate Graph"
      }
    },
    "/parse-chat-prompt": {
      "post": {
        "description": "Recover structured chat turns from a rendered prompt string.\n\nDeliberately does NOT take ``request_lock``: this is tokenizer-only string\nwork with no GPU involvement, and the webapp calls it while opening a modal,\nso a graph generation in flight must not turn it into a 503.\n\n``prompt`` echoes back the BOS-stripped input. A non-chat prompt has no\n``messages`` to carry the strip, and the caller wants to put the string back\nin an editor, so returning it here is what keeps the BOS literal out of the\nfrontend.\n\n``unsteerable_positions`` is the set ``/steer`` will silently drop features\nat, computed here the same way and from the same normalized prompt. A steer\nUI needs it to know which sliders would do nothing; without it the client has\nto guess from token strings, which is the token knowledge this endpoint\nexists to keep server-side.",
        "operationId": "parse_chat_prompt_handler_parse_chat_prompt_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "title": "X-Secret-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseChatPromptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseChatPromptResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Parse Chat Prompt Handler"
      }
    },
    "/steer": {
      "post": {
        "description": "Handle steer requests",
        "operationId": "steer_handler_steer_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-secret-key",
            "required": false,
            "schema": {
              "title": "X-Secret-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SteerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SteerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Steer Handler"
      }
    }
  }
}
