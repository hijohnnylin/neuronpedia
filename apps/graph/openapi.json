      "GraphGenerationResponse": {
        "description": "The receipt from an upload.\n\nOnly describes the ``signed_url`` path, which is the only one the webapp uses. Called\nwithout a ``signed_url`` the endpoint returns the ``circuit_tracer`` graph model itself,\nwhose schema is not ours to publish (see the module docstring).",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "success": {
            "anyOf": [
