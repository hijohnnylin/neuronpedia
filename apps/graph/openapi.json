            "default": false,
            "title": "Steer Generated Tokens",
            "type": "boolean"
          },
          "steer_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Steer Position"
          },
          "token_active_position": {
            "title": "Token Active Position",
            "type": "integer"
          }
        },
        "required": [
