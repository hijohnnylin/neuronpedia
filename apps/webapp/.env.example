# ========================== Required Variables ==========================

# Domain of your main site
NEXT_PUBLIC_URL=http://localhost:3000

# Auth will redirect to this domain
NEXTAUTH_URL=http://localhost:3000

# Secret for hashing auth tokens
NEXTAUTH_SECRET=88888888888888888888888888888888

# Database
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ========================== Optional Variables ==========================

# Error reporting (Sentry). Leave both blank to keep Sentry switched off entirely.
# Both take the same DSN from the same Sentry project; two variables are needed because only
# NEXT_PUBLIC_-prefixed values are inlined into the browser bundle. Setting only SENTRY_DSN
# reports server and edge errors while silently dropping everything that happens in a browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time, so that production stack traces name your
# files rather than minified bundles. Create one at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=