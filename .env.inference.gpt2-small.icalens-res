# ICA Lens (arXiv 2606.11722) as StandardSAEs, one per block output. See
# apps/inference/neuronpedia_inference/extra_saes.yaml for where the set is defined.
MODEL_ID=openai-community/gpt2
OVERRIDE_MODEL_ID=openai-community/gpt2
MODEL_DTYPE=float32
SAE_DTYPE=float32
SAE_SETS='["icalens-res"]'
MAX_LOADED_SAES=200
TOKEN_LIMIT=1024
FORCE_BACKEND=eager
