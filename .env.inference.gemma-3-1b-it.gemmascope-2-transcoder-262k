# NOTE: against a released SAELens this config loads ZERO SAEs. 6.49.0 restricted the
# Neuronpedia aliases to sources neuronpedia.org serves, which dropped the gemma-3-1b-it
# transcoder set (the 4b-it and 1b-it res configs are unaffected). The server still starts,
# so the failure is silent. See the sae-lens comment in apps/inference/pyproject.toml.
MODEL_ID=google/gemma-3-1b-it
OVERRIDE_MODEL_ID=google/gemma-3-1b-it
CUSTOM_HF_MODEL_ID=google/gemma-3-1b-it
MODEL_DTYPE=bfloat16
SAE_DTYPE=bfloat16
SAE_SETS='["gemmascope-2-transcoder-262k"]'
MAX_LOADED_SAES=200
DEVICE=cuda
# Pinned rather than left to interp_engine's select_backend: eager is what a single-GPU
# local run wants, and a fixed backend is one this repo can be read for. Matches
# .env.inference.gpt2-small.res-jb.
FORCE_BACKEND=eager
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0
# Explicit Neuronpedia model id for the Jacobian-lens loader (np_model_to_hf.json is not baked
# into the inference image; without either, JACOBIAN_LENS is unavailable and only LOGIT_LENS works).
NEURONPEDIA_MODEL_ID=gemma-3-1b-it
