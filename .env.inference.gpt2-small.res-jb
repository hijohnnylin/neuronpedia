MODEL_ID=openai-community/gpt2
OVERRIDE_MODEL_ID=openai-community/gpt2
MODEL_DTYPE=float32
SAE_DTYPE=float32
SAE_SETS='["res-jb"]'
MAX_LOADED_SAES=200
# GPT-2 is small enough that eager is the better local-dev default: it starts
# faster, and it avoids vLLM reserving most of the GPU up front, which otherwise
# leaves no room for the res-jb SAEs on a single-GPU machine.
FORCE_BACKEND=eager
