# Serves the persona trait readouts for this checkpoint. The pod stores no axes: the webapp
# reads them from the database and sends them with each request.
#
# SAE_SETS is empty on purpose. A readout projects a captured activation onto a fitted
# direction, so this pod needs the model and capture hooks and nothing else; an empty set makes
# startup skip the SAELens directory entirely. Do not set GENERATION_ONLY here -- that trades
# away the capture hooks the readouts are, leaving a pod that can only generate.
#
# The traits sit at layers 13, 15, 18, 19 and 29, all read from one forward per request. They
# were fitted with `date_string` pinned, which each axis row carries and the endpoint applies,
# so nothing about the date belongs in this file.
MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
MODEL_DTYPE=bfloat16
TOKEN_LIMIT=8192
SAE_SETS='[]'
